@model IEnumerable<CosmeticStore.Models.SanPham>
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- ================= HERO ================= -->
<section class="annie-hero">
    <div class="container">

        <div class="annie-hero-banner">

            <img src="~/images/home/annie-hero-banner.png"
                 alt="Annie Cosmetics"
                 class="annie-hero-img" />

        </div>

    </div>
</section>

<!-- =========================================================
     TIỆN ÍCH DƯỚI HERO
     Không trùng với cam kết cuối trang
     ========================================================= -->
<section class="home-quick-benefits">

    <div class="container">

        <div class="quick-benefit-grid">

            <div class="quick-benefit-card benefit-pink">

                <div class="quick-benefit-icon">
                    <i class="bi bi-gift"></i>
                </div>

                <div>
                    <strong>Ưu đãi mỗi ngày</strong>
                    <span>Giá tốt bất ngờ</span>
                </div>

            </div>


            <div class="quick-benefit-card benefit-yellow">

                <div class="quick-benefit-icon">
                    <i class="bi bi-award"></i>
                </div>

                <div>
                    <strong>Tích điểm thành viên</strong>
                    <span>Nhận quà hấp dẫn</span>
                </div>

            </div>


            <div class="quick-benefit-card benefit-blue">

                <div class="quick-benefit-icon">
                    <i class="bi bi-credit-card"></i>
                </div>

                <div>
                    <strong>Thanh toán tiện lợi</strong>
                    <span>Nhiều phương thức</span>
                </div>

            </div>


            <div class="quick-benefit-card benefit-purple">

                <div class="quick-benefit-icon">
                    <i class="bi bi-headset"></i>
                </div>

                <div>
                    <strong>Tư vấn chuyên sâu</strong>
                    <span>Hỗ trợ lựa chọn sản phẩm</span>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     DANH MỤC NỔI BẬT
     ========================================================= -->
<section class="beauty-home-section">

    <div class="container">

        <div class="beauty-section-heading">

            <span class="section-decoration">
                <i class="bi bi-stars"></i>
            </span>

            <h2>
                DANH MỤC NỔI BẬT
            </h2>

            <p>
                Lựa chọn sản phẩm phù hợp với nhu cầu của bạn
            </p>

        </div>


        <div class="home-category-grid">

            <a asp-controller="CuaHang"
                   asp-action="Index"
                   asp-route-maDanhMuc="1"
                   class="home-category-item category-pink">

                <div class="home-category-photo">

                    <img src="~/images/home/trangdiem.png"
                         alt="Trang điểm" />

                </div>

                <h3>Trang điểm</h3>

                <span>
                    Xem sản phẩm
                    <i class="bi bi-arrow-right"></i>
                </span>

            </a>


            <a asp-controller="CuaHang"
                   asp-action="Index"
                   asp-route-maDanhMuc="2"
                   class="home-category-item category-green">

                <div class="home-category-photo">

                    <img src="~/images/home/chamsocda.png
"
                         alt="Chăm sóc da" />

                </div>

                <h3>Chăm sóc da</h3>

                <span>
                    Xem sản phẩm
                    <i class="bi bi-arrow-right"></i>
                </span>

            </a>


            <a asp-controller="CuaHang"
                   asp-action="Index"
                   asp-route-maDanhMuc="5"
                   class="home-category-item category-purple">

                <div class="home-category-photo">

                    <img src="~/images/home/nuochoa.png"
                         alt="Nước hoa" />

                </div>

                <h3>Nước hoa</h3>

                <span>
                    Xem sản phẩm
                    <i class="bi bi-arrow-right"></i>
                </span>

            </a>


            <a asp-controller="CuaHang"
                   asp-action="Index"
                   asp-route-maDanhMuc="3"
                   class="home-category-item category-yellow">

                <div class="home-category-photo">

                    <img src="~/images/home/chansoctoc.png"
                         alt="Chăm sóc tóc" />

                </div>

                <h3>Chăm sóc tóc</h3>

                <span>
                    Xem sản phẩm
                    <i class="bi bi-arrow-right"></i>
                </span>

            </a>


            <a asp-controller="CuaHang"
                   asp-action="Index"
                   asp-route-maDanhMuc="4"
                   class="home-category-item category-blue">

                <div class="home-category-photo">

                    <img src="~/images/home/chamsoccothe.png"
                         alt="Chăm sóc cơ thể" />

                </div>

                <h3>Chăm sóc cơ thể</h3>

                <span>
                    Xem sản phẩm
                    <i class="bi bi-arrow-right"></i>
                </span>

            </a>

        </div>

    </div>

</section>


<!-- =========================================================
     SẢN PHẨM MỚI
     ========================================================= -->
<section class="beauty-home-section product-home-section">

    <div class="container">

        <div class="beauty-heading-row">

            <div>

                <span class="home-mini-title">
                    NEW ARRIVALS
                </span>

                <h2>
                    SẢN PHẨM MỚI
                </h2>

            </div>

            <a asp-controller="CuaHang"
                   asp-action="Index"
                   class="home-view-more">

                Xem tất cả
                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <div class="home-product-grid">

            @foreach (var sanPham in Model)
            {
                <div class="home-product-card">

                    <div class="home-product-photo">

                        <span class="product-new-badge">
                            Mới
                        </span>

                        <a asp-controller="CuaHang"
                               asp-action="Details"
                               asp-route-id="@sanPham.MaSanPham"
                               class="product-heart"
                               aria-label="Xem sản phẩm">

                            <i class="bi bi-heart"></i>

                        </a>

                        @if (!string.IsNullOrWhiteSpace(sanPham.HinhAnh))
                        {
                            <img src="@sanPham.HinhAnh"
                                 alt="@sanPham.TenSanPham" />
                        }
                        else
                        {
                            <div class="text-muted">
                                Chưa có hình ảnh
                            </div>
                        }

                    </div>


                    <div class="home-product-content">

                        <small>
                            @(sanPham.DanhMuc?.TenDanhMuc ?? "MỸ PHẨM")
                        </small>

                        <h3>
                            @sanPham.TenSanPham
                        </h3>

                        <strong>
                            @sanPham.GiaBan.ToString("N0")đ
                        </strong>

                    </div>

                </div>
            }

        </div>

    </div>

</section>


<!-- =========================================================
     ƯU ĐÃI / CHƯƠNG TRÌNH
     ========================================================= -->
<section class="campaign-section">

    <div class="container">

        <div class="campaign-grid">

            <!-- VOUCHER GIẢM TIỀN -->
            <div class="campaign-card campaign-yellow">

                <div class="campaign-content">

                    <span>
                        VOUCHER ĐỘC QUYỀN
                    </span>

                    <h2>
                        GIẢM 8%
                    </h2>

                    <h3>
                        DÀNH CHO THÀNH VIÊN
                    </h3>

                    <p>
                        Nhận voucher khi đạt hạng thành viên.
                    </p>

                    <a asp-controller="CuaHang"
                           asp-action="Index">

                        Dùng ngay
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

                <div class="campaign-decoration">
                    <i class="bi bi-ticket-perforated"></i>
                </div>

            </div>


            <!-- TÍCH ĐIỂM -->
            <div class="campaign-card campaign-purple">

                <div class="campaign-content">

                    <span>
                        KHÁCH HÀNG THÂN THIẾT
                    </span>

                    <h2>
                        TÍCH ĐIỂM
                    </h2>

                    <h3>
                        ĐỔI QUÀ
                    </h3>

                    <p>
                        Mua càng nhiều, nhận càng nhiều ưu đãi.
                    </p>

                    <a href="#">
                        Tham gia ngay
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

                <div class="campaign-decoration">
                    <i class="bi bi-gift"></i>
                </div>

            </div>


            <!-- FREESHIP -->
            <div class="campaign-card campaign-green">

                <div class="campaign-content">

                    <span>
                        GIAO HÀNG
                    </span>

                    <h2>
                        FREESHIP
                    </h2>

                    <h3>
                        TOÀN QUỐC
                    </h3>

                    <p>
                        Miễn phí vận chuyển cho đơn từ 499K.
                    </p>

                    <a asp-controller="CuaHang"
                           asp-action="Index">

                        Mua ngay
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

                <div class="campaign-decoration">
                    <i class="bi bi-truck"></i>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     CHƯƠNG TRÌNH MỚI
     ========================================================= -->
<section class="beauty-home-section">

    <div class="container">

        <div class="beauty-section-heading">

            <span class="section-decoration">
                <i class="bi bi-stars"></i>
            </span>

            <h2>
                CHƯƠNG TRÌNH MỚI
            </h2>

            <p>
                Thêm nhiều ưu đãi dành riêng cho bạn
            </p>

        </div>


        <div class="new-program-grid">

            <!-- FLASH SALE -->
            <div class="program-card program-orange">

                <div class="program-content">

                    <span>
                        FLASH SALE
                    </span>

                    <h3>
                        GIỜ VÀNG
                    </h3>

                    <p>
                        Săn giá tốt vào
                        <br />
                        khung giờ đặc biệt.
                    </p>

                    <a asp-controller="CuaHang"
                           asp-action="Index">

                        Xem ngay
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

                <div class="program-icon">
                    <i class="bi bi-alarm"></i>
                </div>

            </div>


            <!-- SINH NHẬT -->
            <div class="program-card program-blue">

                <div class="program-content">

                    <span>
                        ƯU ĐÃI SINH NHẬT
                    </span>

                    <h3>
                        NHẬN QUÀ
                    </h3>

                    <p>
                        Quà đặc biệt dành
                        <br />
                        cho tháng sinh nhật.
                    </p>

                    <a href="#">
                        Xem ưu đãi
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

                <div class="program-icon">
                    <i class="bi bi-balloon-heart"></i>
                </div>

            </div>


            <!-- KHÁCH MỚI -->
            <div class="program-card program-mint">

                <div class="program-content">

                    <span>
                        KHÁCH HÀNG MỚI
                    </span>

                    <h3>
                        GIẢM 20K
                    </h3>

                    <p>
                        Nhập mã
                        <strong>NEW20</strong>
                        <br />
                        cho đơn hàng đầu tiên.
                    </p>

                    <a asp-controller="CuaHang"
                           asp-action="Index">

                        Săn ngay
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

                <div class="program-icon">
                    <i class="bi bi-ticket-perforated"></i>
                </div>

            </div>


            <!-- COMBO -->
            <div class="program-card program-pink">

                <div class="program-content">

                    <span>
                        COMBO ƯU ĐÃI
                    </span>

                    <h3>
                        MUA COMBO
                    </h3>

                    <p>
                        Tiết kiệm hơn
                        <br />
                        khi mua theo bộ.
                    </p>

                    <a asp-controller="CuaHang"
                           asp-action="Index">

                        Khám phá
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

                <div class="program-icon">
                    <i class="bi bi-bag-heart"></i>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- ================= THƯƠNG HIỆU NỔI BẬT ================= -->
<section class="brand-section-home">

    <div class="container">

        <div class="beauty-heading-row">

            <div>
                <span class="home-mini-title">
                    TOP BRANDS
                </span>

                <h2>
                    THƯƠNG HIỆU NỔI BẬT
                </h2>
            </div>

            <a asp-controller="CuaHang"
                   asp-action="ThuongHieu"
                   class="home-view-more">
                Xem tất cả
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>


        <div class="beauty-brand-grid">

            @{
                var thuongHieuNoiBat =
                    ViewBag.ThuongHieuNoiBat
                    as List<CosmeticStore.Models.ThuongHieu>;
            }

            @if (thuongHieuNoiBat != null)
            {
                foreach (var brand in thuongHieuNoiBat)
                {
                    <a asp-controller="CuaHang"
                           asp-action="Index"
                           asp-route-maThuongHieu="@brand.MaThuongHieu"
                           class="beauty-brand-box">

                        @if (!string.IsNullOrWhiteSpace(brand.Logo))
                        {
                            <img src="@brand.Logo"
                                 alt="@brand.TenThuongHieu"
                                 class="home-brand-logo" />
                        }
                        else
                        {
                            <span>
                                @brand.TenThuongHieu
                            </span>
                        }

                    </a>
                }
            }

        </div>

    </div>

</section>


<!-- =========================================================
     CAM KẾT CUỐI TRANG
     NỀN TRẮNG BÌNH THƯỜNG
     ========================================================= -->
<section class="beauty-guarantee">

    <div class="container">

        <div class="beauty-guarantee-grid">

            <div class="guarantee-item">

                <div class="guarantee-icon">
                    <i class="bi bi-patch-check"></i>
                </div>

                <div>

                    <strong>
                        100% CHÍNH HÃNG
                    </strong>

                    <span>
                        Cam kết sản phẩm chính hãng
                    </span>

                </div>

            </div>


            <div class="guarantee-item">

                <div class="guarantee-icon">
                    <i class="bi bi-truck"></i>
                </div>

                <div>

                    <strong>
                        GIAO HÀNG TOÀN QUỐC
                    </strong>

                    <span>
                        Miễn phí đơn từ 499K
                    </span>

                </div>

            </div>


            <div class="guarantee-item">

                <div class="guarantee-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <div>

                    <strong>
                        ĐỔI TRẢ DỄ DÀNG
                    </strong>

                    <span>
                        Hỗ trợ đổi trả trong 7 ngày
                    </span>

                </div>

            </div>


            <div class="guarantee-item">

                <div class="guarantee-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>

                <div>

                    <strong>
                        THANH TOÁN AN TOÀN
                    </strong>

                    <span>
                        Bảo mật thông tin tuyệt đối
                    </span>

                </div>

            </div>

        </div>

    </div>

</section>