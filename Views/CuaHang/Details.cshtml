@model CosmeticStore.Models.SanPham

@{
    ViewData["Title"] = Model.TenSanPham;
}

<div class="container py-4">

    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ThongBaoLoi"]
        </div>
    }

    <div class="row g-5">

        <!-- Hình ảnh sản phẩm -->
        <div class="col-md-6">
            @if (!string.IsNullOrWhiteSpace(Model.HinhAnh))
            {
                <img src="@Model.HinhAnh"
                     alt="@Model.TenSanPham"
                     class="img-fluid rounded shadow-sm w-100"
                     style="height: 500px; object-fit: cover;" />
            }
            else
            {
                <div class="bg-light rounded shadow-sm
                    d-flex align-items-center
                    justify-content-center"
                     style="height: 500px;">
                    <span class="text-muted">
                        Chưa có hình ảnh
                    </span>
                </div>
            }
        </div>

        <!-- Thông tin sản phẩm -->
        <div class="col-md-6">
            <p class="text-uppercase text-muted mb-2">
                Sản phẩm
            </p>

            <h1 class="mb-3">
                @Model.TenSanPham
            </h1>

            <h3 class="text-danger mb-4">
                @Model.GiaBan.ToString("N0") đ
            </h3>

            <hr />

            <h5 class="mt-4">Mô tả sản phẩm</h5>

            <p class="text-muted">
                @if (string.IsNullOrWhiteSpace(Model.MoTa))
                {
                    <span>Sản phẩm chưa có mô tả.</span>
                }
                else
                {
                    @Model.MoTa
                }
            </p>

            @if (Model.SoLuongTon > 0)
            {
                <p class="text-success">
                    Còn hàng: @Model.SoLuongTon sản phẩm
                </p>

                <!-- Form thêm vào giỏ hàng -->
                <form asp-controller="GioHang"
                      asp-action="ThemVaoGio"
                      method="post"
                      class="mt-3">

                    <input type="hidden"
                           name="id"
                           value="@Model.MaSanPham" />

                    <label for="soLuong"
                           class="form-label">
                        Số lượng
                    </label>

                    <input type="number"
                           id="soLuong"
                           name="soLuong"
                           value="1"
                           min="1"
                           max="@Model.SoLuongTon"
                           class="form-control mb-3"
                           style="max-width: 120px;" />

                    <button type="submit"
                            class="btn btn-dark btn-lg w-100">
                        Thêm vào giỏ hàng
                    </button>
                </form>
            }
            else
            {
                <p class="text-danger">
                    Sản phẩm hiện đã hết hàng.
                </p>

                <button type="button"
                        class="btn btn-secondary btn-lg w-100"
                        disabled>
                    Hết hàng
                </button>
            }

            <div class="mt-4">
                <a asp-controller="CuaHang"
                       asp-action="Index"
                       class="text-decoration-none">
                    ← Quay lại danh sách sản phẩm
                </a>
            </div>
        </div>
    </div>
</div>