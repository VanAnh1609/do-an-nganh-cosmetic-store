@model CosmeticStore.Models.SanPham

@{
    ViewData["Title"] = Model.TenSanPham;

    var danhGiasDaDuyet = Model.DanhGias?
        .Where(dg => dg.DaDuyet)
        .OrderByDescending(dg => dg.NgayDanhGia)
        .ToList();
}

<div class="container py-4">

    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ThongBaoLoi"]
        </div>
    }

    @if (TempData["ThongBaoThanhCong"] != null)
    {
        <div class="alert alert-success">
            @TempData["ThongBaoThanhCong"]
        </div>
    }

    <!-- THÔNG TIN SẢN PHẨM -->
    <div class="row g-5">

        <!-- Hình ảnh sản phẩm -->
        <div class="col-md-6">

            @if (!string.IsNullOrWhiteSpace(Model.HinhAnh))
            {
                <img id="anhChinh"
                     src="@Model.HinhAnh"
                     alt="@Model.TenSanPham"
                     class="img-fluid rounded shadow-sm w-100"
                     style="height: 500px;
                object-fit: contain;
                background-color: #fff;
                cursor: zoom-in;"
                     onclick="moAnhLon()" />
            }
            else
            {
                <div class="bg-light rounded shadow-sm
                    d-flex align-items-center
                    justify-content-center"
                     style="height: 500px;">

                    <span class="text-muted">
                        Chưa có hình ảnh
                    </span>

                </div>
            }

            <!-- Gallery ảnh chi tiết -->
            @if (Model.HinhAnhSanPhams != null &&
                             Model.HinhAnhSanPhams.Any(a => !a.LaAnhDaiDien))
            {
                <div class="mt-3">
                    <div class="row g-2">

                        @foreach (var anh in Model.HinhAnhSanPhams
                                                    .Where(a => !a.LaAnhDaiDien)
                                                    .OrderBy(a => a.ThuTu))
                        {
                            <div class="col-3">

                                <img src="@anh.DuongDan"
                                     alt="@anh.MoTa"
                                     class="img-thumbnail w-100"
                                     style="height: 100px;
                                object-fit: cover;
                                cursor: pointer;"
                                     onclick="doiAnhChinh('@anh.DuongDan')" />

                            </div>
                        }

                    </div>
                </div>
            }

        </div>

        <!-- Thông tin sản phẩm -->
        <div class="col-md-6">

            <p class="text-uppercase text-muted mb-2">
                Sản phẩm
            </p>

            <h1 class="mb-3">
                @Model.TenSanPham
            </h1>

            <h3 class="text-danger mb-4">
                @Model.GiaBan.ToString("N0") đ
            </h3>

            <hr />

            <h5 class="mt-4">
                Mô tả sản phẩm
            </h5>

            <p class="text-muted">
                @if (string.IsNullOrWhiteSpace(Model.MoTa))
                {
                    <span>
                        Sản phẩm chưa có mô tả.
                    </span>
                }
                else
                {
                    @Model.MoTa
                }
            </p>

            @if (Model.SoLuongTon > 0)
            {
                <p class="text-success">
                    Còn hàng: @Model.SoLuongTon sản phẩm
                </p>

                <form asp-controller="GioHang"
                      asp-action="ThemVaoGio"
                      method="post"
                      class="mt-3">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.MaSanPham" />

                    <label for="soLuong"
                           class="form-label">
                        Số lượng
                    </label>

                    <input type="number"
                           id="soLuong"
                           name="soLuong"
                           value="1"
                           min="1"
                           max="@Model.SoLuongTon"
                           class="form-control mb-3"
                           style="max-width: 120px;" />

                    <button type="submit"
                            class="btn btn-dark btn-lg w-100">
                        Thêm vào giỏ hàng
                    </button>

                </form>
            }
            else
            {
                <p class="text-danger">
                    Sản phẩm hiện đã hết hàng.
                </p>

                <button type="button"
                        class="btn btn-secondary btn-lg w-100"
                        disabled>
                    Hết hàng
                </button>
            }

            <div class="mt-4">

                <a asp-controller="CuaHang"
                       asp-action="Index"
                       class="text-decoration-none">
                    ← Quay lại danh sách sản phẩm
                </a>

            </div>

        </div>

    </div>

    <!-- ĐÁNH GIÁ TỪ KHÁCH HÀNG -->
    <hr class="my-5" />

    <div class="mb-5">

        <h3 class="mb-4">
            Đánh giá từ khách hàng
        </h3>

        @if (danhGiasDaDuyet != null &&
                     danhGiasDaDuyet.Any())
        {
            @foreach (var danhGia in danhGiasDaDuyet)
            {
                <div class="card shadow-sm mb-3">

                    <div class="card-body p-4">

                        <div class="d-flex
                            justify-content-between
                            align-items-center
                            mb-2">

                            <strong>
                                @(danhGia.KhachHang?.HoTen
                                  ?? "Khách hàng")
                            </strong>

                            <small class="text-muted">
                                @danhGia.NgayDanhGia.ToString("dd/MM/yyyy")
                            </small>

                        </div>

                        <div class="text-warning fs-5 mb-2">

                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= danhGia.SoSao)
                                {
                                    <span>★</span>
                                }
                                else
                                {
                                    <span class="text-secondary">
                                        ☆
                                    </span>
                                }
                            }

                            <span class="text-dark fs-6 ms-2">
                                @danhGia.SoSao/5
                            </span>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(danhGia.BinhLuan))
                        {
                            <p class="mb-0">
                                @danhGia.BinhLuan
                            </p>
                        }

                    </div>

                </div>
            }
        }
        else
        {
            <div class="alert alert-light border">
                Chưa có đánh giá nào cho sản phẩm này.
            </div>
        }

    </div>

</div>


<!-- Modal phóng to ảnh -->
<div class="modal fade"
     id="xemAnhModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog
        modal-dialog-centered
        modal-xl">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    @Model.TenSanPham
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Đóng">
                </button>

            </div>

            <div class="modal-body text-center">

                <img id="anhPhongTo"
                     src=""
                     alt="@Model.TenSanPham"
                     class="img-fluid"
                     style="max-height: 80vh;
                max-width: 100%;
                object-fit: contain;" />

            </div>

        </div>

    </div>

</div>


<script>

    function doiAnhChinh(duongDan) {

        const anhChinh =
            document.getElementById("anhChinh");

        if (anhChinh) {
            anhChinh.src = duongDan;
        }
    }

    function moAnhLon() {

        const anhChinh =
            document.getElementById("anhChinh");

        const anhPhongTo =
            document.getElementById("anhPhongTo");

        const modalElement =
            document.getElementById("xemAnhModal");

        if (!anhChinh ||
            !anhPhongTo ||
            !modalElement) {
            return;
        }

        anhPhongTo.src = anhChinh.src;

        const modal =
            bootstrap.Modal.getOrCreateInstance(
                modalElement
            );

        modal.show();
    }

</script>