@model IEnumerable<CosmeticStore.Models.SanPham>

@{
    ViewData["Title"] = "Cửa hàng";
}

<div class="text-center mb-5">
    <h1>Sản phẩm của chúng tôi</h1>
    <p class="text-muted">
        Khám phá các sản phẩm mỹ phẩm dành cho bạn
    </p>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        Hiện tại cửa hàng chưa có sản phẩm.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var sanPham in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">

                    @if (!string.IsNullOrWhiteSpace(sanPham.HinhAnh))
                    {
                        <img src="@sanPham.HinhAnh"
                             alt="@sanPham.TenSanPham"
                             class="card-img-top"
                             style="height: 260px;
                        object-fit: contain;
                        background-color: #fff;
                        padding: 12px;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center"
                             style="height: 260px;">
                            <span class="text-muted">Chưa có hình ảnh</span>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            @sanPham.TenSanPham
                        </h5>

                        <p class="card-text text-muted">
                            @sanPham.MoTa
                        </p>

                        <p class="fs-5 fw-bold text-danger mt-auto mb-2">
                            @sanPham.GiaBan.ToString("N0") đ
                        </p>

                        @if (sanPham.SoLuongTon > 0)
                        {
                            <small class="text-success">
                                Còn hàng: @sanPham.SoLuongTon sản phẩm
                            </small>
                        }
                        else
                        {
                            <small class="text-danger">
                                Hết hàng
                            </small>
                        }
                        <!-- Nút xem chi tiết nằm ở đây -->
                        <a asp-controller="CuaHang"
                               asp-action="Details"
                               asp-route-id="@sanPham.MaSanPham"
                               class="btn btn-outline-dark mt-3">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}