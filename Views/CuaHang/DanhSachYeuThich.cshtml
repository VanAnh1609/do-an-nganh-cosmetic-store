@model IEnumerable<CosmeticStore.Models.YeuThich>

@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}

<div class="container py-4">

    <div class="d-flex
        justify-content-between
        align-items-center
        mb-4">

        <div>
            <h1 class="mb-1">
                Sản phẩm yêu thích
            </h1>

            <p class="text-muted mb-0">
                Danh sách những sản phẩm bạn đã lưu.
            </p>
        </div>

        <a asp-controller="CuaHang"
               asp-action="Index"
               class="btn btn-outline-dark">
            Tiếp tục mua sắm
        </a>

    </div>

    @if (TempData["ThongBaoThanhCong"] != null)
    {
        <div class="alert alert-success">
            @TempData["ThongBaoThanhCong"]
        </div>
    }

    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ThongBaoLoi"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4">

            <div class="mb-2">
                Bạn chưa có sản phẩm yêu thích nào.
            </div>

            <a asp-controller="CuaHang"
                   asp-action="Index"
                   class="btn btn-dark mt-2">
                Khám phá sản phẩm
            </a>

        </div>
    }
    else
    {
        <div class="row
            row-cols-1
            row-cols-sm-2
            row-cols-lg-3
            g-4">

            @foreach (var yeuThich in Model)
            {
                var sanPham = yeuThich.SanPham;

                if (sanPham != null)
                {
                    <div class="col">

                        <div class="card h-100 shadow-sm">

                            @if (!string.IsNullOrWhiteSpace(sanPham.HinhAnh))
                            {
                                <img src="@sanPham.HinhAnh"
                                     alt="@sanPham.TenSanPham"
                                     class="card-img-top"
                                     style="height: 260px;
                                object-fit: contain;
                                background-color: #fff;
                                padding: 12px;" />
                            }
                            else
                            {
                                <div class="bg-light
                                    d-flex
                                    align-items-center
                                    justify-content-center"
                                     style="height: 260px;">

                                    <span class="text-muted">
                                        Chưa có hình ảnh
                                    </span>

                                </div>
                            }

                            <div class="card-body
                                d-flex
                                flex-column">

                                <h5 class="card-title">
                                    @sanPham.TenSanPham
                                </h5>

                                <p class="fs-5
                                    fw-bold
                                    text-danger
                                    mb-2">
                                    @sanPham.GiaBan.ToString("N0") đ
                                </p>

                                @if (sanPham.SoLuongTon > 0)
                                {
                                    <small class="text-success mb-3">
                                        Còn hàng:
                                        @sanPham.SoLuongTon sản phẩm
                                    </small>
                                }
                                else
                                {
                                    <small class="text-danger mb-3">
                                        Hết hàng
                                    </small>
                                }

                                <div class="mt-auto d-flex gap-2">

                                    <a asp-controller="CuaHang"
                                           asp-action="Details"
                                           asp-route-id="@sanPham.MaSanPham"
                                           class="btn
                                        btn-outline-dark
                                        flex-grow-1">
                                        Xem chi tiết
                                    </a>

                                    <form asp-controller="CuaHang"
                                          asp-action="BoYeuThich"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="maSanPham"
                                               value="@sanPham.MaSanPham" />

                                        <input type="hidden"
                                               name="returnUrl"
                                               value="@Context.Request.Path" />

                                        <button type="submit"
                                                class="btn btn-outline-danger"
                                                onclick="return confirm('Bạn có muốn bỏ sản phẩm này khỏi danh sách yêu thích không?');">
                                            Bỏ yêu thích
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>
    }

</div>