@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Đăng nhập - CosmeticStore</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <!-- CSS riêng Login / Register -->
    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
</head>

<body>

    <div class="auth-page">

        <div class="auth-card">

            <!-- BÊN TRÁI -->
            <div class="auth-left">

                <div class="auth-left-content">

                    <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index"
                           class="auth-logo">

                        <span class="auth-logo-main">
                            Cosmetic
                        </span>

                        <span class="auth-logo-sub">
                            STORE
                        </span>

                    </a>

                    <span class="auth-kicker">
                        WELCOME BACK
                    </span>

                    <h1>
                        Chào mừng bạn quay trở lại
                    </h1>

                    <p>
                        Đăng nhập để tiếp tục mua sắm,
                        theo dõi đơn hàng và lưu những
                        sản phẩm bạn yêu thích.
                    </p>

                    <div class="auth-heart">
                        ♡
                    </div>

                </div>

            </div>


            <!-- BÊN PHẢI -->
            <div class="auth-right">

                <div class="auth-form">

                    <div class="auth-title">

                        <h2>Đăng nhập</h2>

                        <p>
                            Đăng nhập vào tài khoản CosmeticStore
                        </p>

                    </div>

                    <form id="account"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3"
                             role="alert">
                        </div>

                        <!-- EMAIL -->
                        <div class="mb-3">

                            <label asp-for="Input.Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Input.Email"
                                   class="form-control auth-input"
                                   autocomplete="username"
                                   placeholder="Nhập email của bạn" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- PASSWORD -->
                        <div class="mb-3">

                            <label asp-for="Input.Password"
                                   class="form-label">
                                Mật khẩu
                            </label>

                            <input asp-for="Input.Password"
                                   class="form-control auth-input"
                                   autocomplete="current-password"
                                   placeholder="Nhập mật khẩu" />

                            <span asp-validation-for="Input.Password"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- GHI NHỚ + QUÊN MẬT KHẨU -->
                        <div class="auth-options">

                            <div class="form-check">

                                <input asp-for="Input.RememberMe"
                                       class="form-check-input" />

                                <label asp-for="Input.RememberMe"
                                       class="form-check-label">
                                    Ghi nhớ đăng nhập
                                </label>

                            </div>

                            <a asp-page="./ForgotPassword"
                                   class="auth-link">
                                Quên mật khẩu?
                            </a>

                        </div>

                        <!-- BUTTON -->
                        <button id="login-submit"
                                type="submit"
                                class="auth-button">
                            Đăng nhập
                        </button>

                        <!-- ĐĂNG KÝ -->
                        <div class="auth-bottom">

                            <span class="text-muted">
                                Chưa có tài khoản?
                            </span>

                            <a asp-page="./Register"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="auth-link fw-semibold">
                                Đăng ký ngay
                            </a>

                        </div>

                        <!-- VỀ TRANG CHỦ -->
                        <a asp-area=""
                               asp-controller="Home"
                               asp-action="Index"
                               class="auth-back">
                            ← Quay lại trang chủ
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

</body>

</html>