@page
@model RegisterModel

@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Đăng ký - CosmeticStore</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
</head>

<body>

    <div class="auth-page">

        <div class="auth-card">

            <!-- BÊN TRÁI -->
            <div class="auth-left">

                <div class="auth-left-content">

                    <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index"
                           class="auth-logo">

                        <span class="auth-logo-main">
                            Cosmetic
                        </span>

                        <span class="auth-logo-sub">
                            STORE
                        </span>

                    </a>

                    <span class="auth-kicker">
                        JOIN US
                    </span>

                    <h1>
                        Bắt đầu hành trình làm đẹp cùng chúng tôi
                    </h1>

                    <p>
                        Tạo tài khoản để mua sắm nhanh hơn,
                        theo dõi đơn hàng và lưu những
                        sản phẩm bạn yêu thích.
                    </p>

                    <div class="auth-heart">
                        ♡
                    </div>

                </div>

            </div>


            <!-- BÊN PHẢI -->
            <div class="auth-right">

                <div class="auth-form">

                    <div class="auth-title">

                        <h2>Đăng ký</h2>

                        <p>
                            Tạo tài khoản CosmeticStore của bạn
                        </p>

                    </div>

                    <form id="registerForm"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3"
                             role="alert">
                        </div>

                        <!-- HỌ TÊN -->
                        <div class="mb-3">

                            <label asp-for="Input.HoTen"
                                   class="form-label">
                                Họ và tên
                            </label>

                            <input asp-for="Input.HoTen"
                                   class="form-control auth-input"
                                   placeholder="Nhập họ và tên" />

                            <span asp-validation-for="Input.HoTen"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- EMAIL -->
                        <div class="mb-3">

                            <label asp-for="Input.Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Input.Email"
                                   class="form-control auth-input"
                                   autocomplete="username"
                                   placeholder="Nhập email của bạn" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- SỐ ĐIỆN THOẠI -->
                        <div class="mb-3">

                            <label asp-for="Input.SoDienThoai"
                                   class="form-label">
                                Số điện thoại
                            </label>

                            <input asp-for="Input.SoDienThoai"
                                   class="form-control auth-input"
                                   placeholder="Nhập số điện thoại" />

                            <span asp-validation-for="Input.SoDienThoai"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- MẬT KHẨU -->
                        <div class="mb-3">

                            <label asp-for="Input.Password"
                                   class="form-label">
                                Mật khẩu
                            </label>

                            <input asp-for="Input.Password"
                                   class="form-control auth-input"
                                   autocomplete="new-password"
                                   placeholder="Nhập mật khẩu" />

                            <span asp-validation-for="Input.Password"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- XÁC NHẬN MẬT KHẨU -->
                        <div class="mb-3">

                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label">
                                Xác nhận mật khẩu
                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control auth-input"
                                   autocomplete="new-password"
                                   placeholder="Nhập lại mật khẩu" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger small">
                            </span>

                        </div>

                        <button id="registerSubmit"
                                type="submit"
                                class="auth-button">
                            Đăng ký tài khoản
                        </button>

                        <div class="auth-bottom">

                            <span class="text-muted">
                                Đã có tài khoản?
                            </span>

                            <a asp-page="./Login"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="auth-link fw-semibold">
                                Đăng nhập ngay
                            </a>

                        </div>

                        <a asp-area=""
                               asp-controller="Home"
                               asp-action="Index"
                               class="auth-back">
                            ← Quay lại trang chủ
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

</body>

</html>