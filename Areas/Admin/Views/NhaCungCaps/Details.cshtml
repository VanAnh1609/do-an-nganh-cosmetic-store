@model CosmeticStore.Models.NhaCungCap

@{
    ViewData["Title"] = "Chi tiết nhà cung cấp";
}

<div class="container mt-3">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-0">Chi tiết nhà cung cấp</h4>
                </div>

                <div class="card-body">

                    <dl class="row mb-0">

                        <dt class="col-sm-4">Tên nhà cung cấp</dt>
                        <dd class="col-sm-8">
                            <strong>@Model.TenNhaCungCap</strong>
                        </dd>

                        <dt class="col-sm-4">Số điện thoại</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.SoDienThoai)
                                ? "Chưa có"
                                : Model.SoDienThoai)
                        </dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.Email)
                                ? "Chưa có"
                                : Model.Email)
                        </dd>

                        <dt class="col-sm-4">Địa chỉ</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.DiaChi)
                                ? "Chưa có"
                                : Model.DiaChi)
                        </dd>

                        <dt class="col-sm-4">Trạng thái</dt>
                        <dd class="col-sm-8">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success">
                                    Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Ngừng hoạt động
                                </span>
                            }
                        </dd>

                    </dl>

                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Edit"
                               asp-route-id="@Model.MaNhaCungCap"
                               class="btn btn-warning">
                            Sửa
                        </a>

                        <a asp-action="Index"
                               class="btn btn-secondary">
                            Quay lại
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>