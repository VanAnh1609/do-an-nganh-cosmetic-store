@model IEnumerable<CosmeticStore.Models.NhaCungCap>

@{
    ViewData["Title"] = "Quản lý nhà cung cấp";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý nhà cung cấp</h2>

    <a asp-action="Create" class="btn btn-primary">
        + Thêm nhà cung cấp
    </a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Tên nhà cung cấp</th>
            <th>Số điện thoại</th>
            <th>Email</th>
            <th>Địa chỉ</th>
            <th>Trạng thái</th>
            <th style="width: 190px;">Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <strong>@item.TenNhaCungCap</strong>
                </td>

                <td>
                    @(string.IsNullOrWhiteSpace(item.SoDienThoai)
                        ? "Chưa có"
                        : item.SoDienThoai)
                </td>

                <td>
                    @(string.IsNullOrWhiteSpace(item.Email)
                        ? "Chưa có"
                        : item.Email)
                </td>

                <td>
                    @(string.IsNullOrWhiteSpace(item.DiaChi)
                        ? "Chưa có"
                        : item.DiaChi)
                </td>

                <td>
                    @if (item.TrangThai)
                    {
                        <span class="badge bg-success">
                            Hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Ngừng hoạt động
                        </span>
                    }
                </td>

                <td>
                    <a asp-action="Edit"
                           asp-route-id="@item.MaNhaCungCap"
                           class="btn btn-sm btn-warning">
                        Sửa
                    </a>

                    <a asp-action="Details"
                           asp-route-id="@item.MaNhaCungCap"
                           class="btn btn-sm btn-info">
                        Chi tiết
                    </a>

                    <a asp-action="Delete"
                           asp-route-id="@item.MaNhaCungCap"
                           class="btn btn-sm btn-danger">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>