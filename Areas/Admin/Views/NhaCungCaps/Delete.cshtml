@model CosmeticStore.Models.NhaCungCap

@{
    ViewData["Title"] = "Xóa nhà cung cấp";
}

<div class="container mt-3">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-danger">

                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Xóa nhà cung cấp</h4>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        Bạn có chắc chắn muốn xóa nhà cung cấp này không?
                    </div>

                    <dl class="row">

                        <dt class="col-sm-4">Tên nhà cung cấp</dt>
                        <dd class="col-sm-8">
                            <strong>@Model.TenNhaCungCap</strong>
                        </dd>

                        <dt class="col-sm-4">Số điện thoại</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.SoDienThoai)
                                ? "Chưa có"
                                : Model.SoDienThoai)
                        </dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.Email)
                                ? "Chưa có"
                                : Model.Email)
                        </dd>

                        <dt class="col-sm-4">Địa chỉ</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.DiaChi)
                                ? "Chưa có"
                                : Model.DiaChi)
                        </dd>

                        <dt class="col-sm-4">Trạng thái</dt>
                        <dd class="col-sm-8">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success">
                                    Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Ngừng hoạt động
                                </span>
                            }
                        </dd>

                    </dl>

                    <form asp-action="Delete" method="post">

                        <input type="hidden"
                               asp-for="MaNhaCungCap" />

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-danger">
                                Xác nhận xóa
                            </button>

                            <a asp-action="Index"
                                   class="btn btn-secondary">
                                Quay lại
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>