@model IEnumerable<CosmeticStore.Models.ThuongHieu>

@{
    ViewData["Title"] = "Quản lý thương hiệu";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Quản lý thương hiệu</h1>

            <p class="text-muted mb-0">
                Quản lý các thương hiệu mỹ phẩm trong cửa hàng
            </p>
        </div>

        <a asp-action="Create"
               class="btn btn-primary">
            Thêm thương hiệu
        </a>
    </div>

    @if (TempData["ThongBaoThanhCong"] != null)
    {
        <div class="alert alert-success">
            @TempData["ThongBaoThanhCong"]
        </div>
    }

    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ThongBaoLoi"]
        </div>
    }

    <!-- TÌM KIẾM -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-8">
                    <label class="form-label">
                        Tìm kiếm thương hiệu
                    </label>

                    <input type="text"
                           name="tuKhoa"
                           value="@ViewBag.TuKhoa"
                           class="form-control"
                           placeholder="Nhập tên thương hiệu..." />
                </div>

                <div class="col-md-4">
                    <button type="submit"
                            class="btn btn-primary">
                        Tìm kiếm
                    </button>

                    <a asp-action="Index"
                           class="btn btn-secondary">
                        Đặt lại
                    </a>
                </div>

            </form>

        </div>
    </div>

    <!-- DANH SÁCH THƯƠNG HIỆU -->
    <div class="card shadow-sm">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Mã thương hiệu</th>
                        <th>Tên thương hiệu</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>

                        <th class="text-end">
                            Thao tác
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    #@item.MaThuongHieu
                                </td>

                                <td class="fw-semibold">
                                    @item.TenThuongHieu
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.MoTa)
                                        ? "Chưa có mô tả"
                                        : item.MoTa)
                                </td>

                                <td>
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success">
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Đã ẩn
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                           asp-route-id="@item.MaThuongHieu"
                                           class="btn btn-sm btn-info text-white">
                                        Chi tiết
                                    </a>

                                    <a asp-action="Edit"
                                           asp-route-id="@item.MaThuongHieu"
                                           class="btn btn-sm btn-warning">
                                        Chỉnh sửa
                                    </a>

                                    <form asp-action="DoiTrangThai"
                                          asp-route-id="@item.MaThuongHieu"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        @if (item.TrangThai)
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-secondary">
                                                Ẩn
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-success">
                                                Hiển thị
                                            </button>
                                        }

                                    </form>

                                    <a asp-action="Delete"
                                           asp-route-id="@item.MaThuongHieu"
                                           class="btn btn-sm btn-danger">
                                        Xóa
                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center text-muted py-4">
                                Không tìm thấy thương hiệu phù hợp.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>