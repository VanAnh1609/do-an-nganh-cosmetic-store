@model CosmeticStore.Models.ThuongHieu

@{
    ViewData["Title"] = "Xóa thương hiệu";
}

<h2 class="mb-4 text-danger">Xóa thương hiệu</h2>

<div class="alert alert-warning">
    Bạn có chắc chắn muốn xóa thương hiệu này không?
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-sm-3">
                Mã thương hiệu
            </dt>

            <dd class="col-sm-9">
                #@Model.MaThuongHieu
            </dd>

            <dt class="col-sm-3">
                Tên thương hiệu
            </dt>

            <dd class="col-sm-9">
                @Model.TenThuongHieu
            </dd>

            <dt class="col-sm-3">
                Mô tả
            </dt>

            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.MoTa)
                    ? "Chưa có mô tả"
                    : Model.MoTa)
            </dd>

            <dt class="col-sm-3">
                Trạng thái
            </dt>

            <dd class="col-sm-9">
                @if (Model.TrangThai)
                {
                    <span class="badge bg-success">
                        Hoạt động
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Đã ẩn
                    </span>
                }
            </dd>

        </dl>

    </div>
</div>

<form asp-action="Delete"
      method="post"
      class="mt-3">

    <input type="hidden"
           asp-for="MaThuongHieu" />

    <button type="submit"
            class="btn btn-danger">
        Xác nhận xóa
    </button>

    <a asp-action="Index"
           class="btn btn-secondary">
        Hủy
    </a>

</form>