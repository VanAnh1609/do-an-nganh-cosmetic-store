@model CosmeticStore.Models.KhachHang

@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<div class="container mt-4">
    <h2 class="mb-4">Chi tiết khách hàng</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row mb-0">

                <dt class="col-sm-3">Mã khách hàng</dt>
                <dd class="col-sm-9">@Model.MaKhachHang</dd>

                <dt class="col-sm-3">Họ và tên</dt>
                <dd class="col-sm-9">@Model.HoTen</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Số điện thoại</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrEmpty(Model.SoDienThoai)
                        ? "Chưa cập nhật"
                        : Model.SoDienThoai)
                </dd>

                <dt class="col-sm-3">Địa chỉ</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrEmpty(Model.DiaChi)
                        ? "Chưa cập nhật"
                        : Model.DiaChi)
                </dd>

                <dt class="col-sm-3">Ngày đăng ký</dt>
                <dd class="col-sm-9">
                    @Model.NgayDangKy.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-3">Trạng thái</dt>
                <dd class="col-sm-9">
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success">
                            Hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Đã khóa
                        </span>
                    }
                </dd>

            </dl>
        </div>
    </div>
    <div class="card shadow-sm mt-4">
        <div class="card-body">

            <h4 class="mb-3">Lịch sử đơn hàng</h4>

            @if (Model.DonHangs != null && Model.DonHangs.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Ngày đặt</th>
                                <th>Người nhận</th>
                                <th>Tổng tiền</th>
                                <th>Thanh toán</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var donHang in Model.DonHangs
                                                        .OrderByDescending(dh => dh.NgayDat))
                            {
                                <tr>
                                    <td>
                                        #@donHang.MaDonHang
                                    </td>

                                    <td>
                                        @donHang.NgayDat.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @donHang.TenNguoiNhan
                                    </td>

                                    <td>
                                        @donHang.TongTien.ToString("N0") đ
                                    </td>

                                    <td>
                                        @donHang.PhuongThucThanhToan
                                    </td>

                                    <td>
                                        @switch (donHang.TrangThai)
                                        {
                                            case "ChoXacNhan":
                                                <span class="badge bg-warning text-dark">
                                                    Chờ xác nhận
                                                </span>
                                                break;

                                            case "DaXacNhan":
                                                <span class="badge bg-info text-dark">
                                                    Đã xác nhận
                                                </span>
                                                break;

                                            case "DangGiao":
                                                <span class="badge bg-primary">
                                                    Đang giao
                                                </span>
                                                break;

                                            case "HoanThanh":
                                                <span class="badge bg-success">
                                                    Hoàn thành
                                                </span>
                                                break;

                                            case "DaHuy":
                                                <span class="badge bg-danger">
                                                    Đã hủy
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">
                                                    @donHang.TrangThai
                                                </span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    Khách hàng chưa có đơn hàng nào.
                </p>
            }

        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit"
               asp-route-id="@Model.MaKhachHang"
               class="btn btn-warning">
            Chỉnh sửa
        </a>

        <a asp-action="Index"
               class="btn btn-secondary">
            Quay lại
        </a>
    </div>
</div>