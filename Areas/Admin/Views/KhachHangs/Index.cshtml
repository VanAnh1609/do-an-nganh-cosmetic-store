@model IEnumerable<CosmeticStore.Models.KhachHang>

@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Quản lý khách hàng</h2>
    </div>

    <!-- TÌM KIẾM + LỌC -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-6">
                    <label class="form-label">
                        Tìm kiếm
                    </label>

                    <input type="text"
                           name="tuKhoa"
                           value="@ViewBag.TuKhoa"
                           class="form-control"
                           placeholder="Nhập họ tên, email hoặc số điện thoại..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label">
                        Trạng thái
                    </label>

                    <select name="trangThai"
                            class="form-select">

                        <option value="">
                            Tất cả trạng thái
                        </option>

                        @if (ViewBag.TrangThai is bool trangThaiDangChon
                                                    && trangThaiDangChon)
                        {
                            <option value="true" selected>
                                Hoạt động
                            </option>
                        }
                        else
                        {
                            <option value="true">
                                Hoạt động
                            </option>
                        }

                        @if (ViewBag.TrangThai is bool trangThaiKhoa
                                                    && !trangThaiKhoa)
                        {
                            <option value="false" selected>
                                Đã khóa
                            </option>
                        }
                        else
                        {
                            <option value="false">
                                Đã khóa
                            </option>
                        }

                    </select>
                </div>

                <div class="col-md-3">
                    <button type="submit"
                            class="btn btn-primary">
                        Tìm kiếm
                    </button>

                    <a asp-action="Index"
                           class="btn btn-secondary">
                        Đặt lại
                    </a>
                </div>

            </form>

        </div>
    </div>

    <!-- DANH SÁCH KHÁCH HÀNG -->
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Mã KH</th>
                            <th>Họ và tên</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Ngày đăng ký</th>
                            <th>Trạng thái</th>
                            <th class="text-center">
                                Thao tác
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.MaKhachHang
                                    </td>

                                    <td>
                                        @item.HoTen
                                    </td>

                                    <td>
                                        @item.Email
                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(item.SoDienThoai)
                                            ? "Chưa cập nhật"
                                            : item.SoDienThoai)
                                    </td>

                                    <td>
                                        @item.NgayDangKy.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @if (item.TrangThai)
                                        {
                                            <span class="badge bg-success">
                                                Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Đã khóa
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Details"
                                               asp-route-id="@item.MaKhachHang"
                                               class="btn btn-sm btn-info text-white">
                                            Chi tiết
                                        </a>

                                        <a asp-action="Edit"
                                               asp-route-id="@item.MaKhachHang"
                                               class="btn btn-sm btn-warning">
                                            Chỉnh sửa
                                        </a>

                                        <form asp-action="DoiTrangThai"
                                              asp-route-id="@item.MaKhachHang"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            @if (item.TrangThai)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Bạn có chắc muốn khóa khách hàng này?')">
                                                    Khóa
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-success">
                                                    Mở khóa
                                                </button>
                                            }

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">
                                    Không tìm thấy khách hàng phù hợp.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>