@model IEnumerable<CosmeticStore.Models.DonHang>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container-fluid py-4">
    <div class="d-flex
        justify-content-between
        align-items-center
        mb-4">

        <div>
            <h1 class="mb-1">Quản lý đơn hàng</h1>

            <p class="text-muted mb-0">
                Theo dõi và xử lý đơn hàng của khách
            </p>
        </div>
    </div>
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-6">
                    <label class="form-label">
                        Tìm kiếm
                    </label>

                    <input type="text"
                           name="tuKhoa"
                           value="@ViewBag.TuKhoa"
                           class="form-control"
                           placeholder="Nhập mã đơn, tên khách hoặc email..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label">
                        Trạng thái
                    </label>

                    <select name="trangThai"
                            class="form-select">

                        <option value="">
                            Tất cả trạng thái
                        </option>

                        <option value="ChoXacNhan"
                                selected="@(ViewBag.TrangThai == "ChoXacNhan")">
                            Chờ xác nhận
                        </option>

                        <option value="DaXacNhan"
                                selected="@(ViewBag.TrangThai == "DaXacNhan")">
                            Đã xác nhận
                        </option>

                        <option value="DangGiao"
                                selected="@(ViewBag.TrangThai == "DangGiao")">
                            Đang giao
                        </option>

                        <option value="DaGiao"
                                selected="@(ViewBag.TrangThai == "Đã giao")">
                            Hoàn thành
                        </option>

                        <option value="DaHuy"
                                selected="@(ViewBag.TrangThai == "DaHuy")">
                            Đã hủy
                        </option>

                    </select>
                </div>

                <div class="col-md-3">
                    <button type="submit"
                            class="btn btn-primary">
                        Tìm kiếm
                    </button>

                    <a asp-action="Index"
                           class="btn btn-secondary">
                        Đặt lại
                    </a>
                </div>

            </form>

        </div>
    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Hiện chưa có đơn hàng nào.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table
                    table-hover
                    align-middle
                    mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Sản phẩm</th>
                            <th>Tổng tiền</th>
                            <th>Thanh toán</th>
                            <th>Trạng thái</th>
                            <th class="text-end">
                                Thao tác
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var donHang in Model)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        DH@(donHang.MaDonHang.ToString("D4"))
                                    </strong>
                                </td>

                                <td>
                                    <div>
                                        <strong>
                                            @donHang.TenNguoiNhan
                                        </strong>
                                    </div>

                                    <small class="text-muted">
                                        @(donHang.KhachHang?.Email
                                          ?? "Không có email")
                                    </small>
                                </td>

                                <td>
                                    @donHang.NgayDat.ToString(
                                        "dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @donHang.ChiTietDonHangs.Sum(
                                        ct => ct.SoLuong)
                                    sản phẩm
                                </td>

                                <td class="fw-bold text-danger">
                                    @donHang.TongTien.ToString("N0") đ
                                </td>

                                <td>
                                    @if (donHang.PhuongThucThanhToan
                                                                            == "COD")
                                    {
                                        <span>COD</span>
                                    }
                                    else
                                    {
                                        <span>Chuyển khoản</span>
                                    }
                                </td>

                                <td>
                                    @if (donHang.TrangThai == "ChoXacNhan")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Chờ xác nhận
                                        </span>
                                    }
                                    else if (donHang.TrangThai == "DaXacNhan")
                                    {
                                        <span class="badge bg-info text-dark">
                                            Đã xác nhận
                                        </span>
                                    }
                                    else if (donHang.TrangThai == "DangGiao")
                                    {
                                        <span class="badge bg-primary">
                                            Đang giao
                                        </span>
                                    }
                                    else if (donHang.TrangThai == "DaGiao")
                                    {
                                        <span class="badge bg-success">
                                            Đã giao
                                        </span>
                                    }
                                    else if (donHang.TrangThai == "DaHuy")
                                    {
                                        <span class="badge bg-danger">
                                            Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @donHang.TrangThai
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-controller="DonHangs"
                                           asp-action="Details"
                                           asp-route-id="@donHang.MaDonHang"
                                           class="btn
                                        btn-outline-dark
                                        btn-sm">
                                        Xem và xử lý
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>