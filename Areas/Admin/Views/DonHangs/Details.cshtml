@model CosmeticStore.Models.DonHang

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">
                Chi tiết đơn hàng #@Model.MaDonHang
            </h1>

            <p class="text-muted mb-0">
                Xem thông tin và xử lý trạng thái đơn hàng
            </p>
        </div>

        <a asp-action="Index"
               class="btn btn-outline-secondary">
            Quay lại danh sách
        </a>
    </div>

    @if (TempData["ThongBaoThanhCong"] != null)
    {
        <div class="alert alert-success">
            @TempData["ThongBaoThanhCong"]
        </div>
    }

    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ThongBaoLoi"]
        </div>
    }

    <div class="row g-4">

        <!-- THÔNG TIN ĐƠN HÀNG -->
        <div class="col-lg-8">

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4 class="mb-4">
                        Thông tin đơn hàng
                    </h4>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            Mã đơn hàng
                        </div>

                        <div class="col-md-8">
                            #@Model.MaDonHang
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            Khách hàng
                        </div>

                        <div class="col-md-8">
                            @Model.KhachHang?.HoTen
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            Email
                        </div>

                        <div class="col-md-8">
                            @(Model.KhachHang?.Email ?? "Không có email")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            Người nhận
                        </div>

                        <div class="col-md-8">
                            @Model.TenNguoiNhan
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            Số điện thoại
                        </div>

                        <div class="col-md-8">
                            @Model.SoDienThoai
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            Địa chỉ giao hàng
                        </div>

                        <div class="col-md-8">
                            @Model.DiaChiGiaoHang
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            Ngày đặt
                        </div>

                        <div class="col-md-8">
                            @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            Phương thức thanh toán
                        </div>

                        <div class="col-md-8">
                            @if (Model.PhuongThucThanhToan == "COD")
                            {
                                <span>Thanh toán khi nhận hàng (COD)</span>
                            }
                            else
                            {
                                <span>@Model.PhuongThucThanhToan</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            Mã giảm giá
                        </div>

                        <div class="col-md-8">
                            @(Model.MaGiamGia?.TenMa ?? "Không sử dụng")
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 fw-semibold">
                            Ghi chú
                        </div>

                        <div class="col-md-8">
                            @(string.IsNullOrWhiteSpace(Model.GhiChu)
                                ? "Không có ghi chú"
                                : Model.GhiChu)
                        </div>
                    </div>

                </div>
            </div>

            <!-- SẢN PHẨM TRONG ĐƠN -->
            <div class="card shadow-sm">
                <div class="card-body">

                    <h4 class="mb-4">
                        Sản phẩm trong đơn hàng
                    </h4>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">

                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-center">
                                        Số lượng
                                    </th>
                                    <th class="text-end">
                                        Đơn giá
                                    </th>
                                    <th class="text-end">
                                        Thành tiền
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.ChiTietDonHangs)
                                {
                                    <tr>

                                        <td>
                                            @(item.SanPham?.TenSanPham
                                                ?? "Sản phẩm không tồn tại")
                                        </td>

                                        <td class="text-center">
                                            @item.SoLuong
                                        </td>

                                        <td class="text-end">
                                            @item.DonGia.ToString("N0") đ
                                        </td>

                                        <td class="text-end fw-semibold">
                                            @((item.DonGia * item.SoLuong)
                                                .ToString("N0")) đ
                                        </td>

                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>

                </div>
            </div>

        </div>

        <!-- XỬ LÝ ĐƠN -->
        <div class="col-lg-4">

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4 class="mb-4">
                        Xử lý đơn hàng
                    </h4>

                    <div class="mb-3">
                        <span class="fw-semibold">
                            Trạng thái hiện tại:
                        </span>

                        <div class="mt-2">
                            @if (Model.TrangThai == "ChoXacNhan")
                            {
                                <span class="badge bg-warning text-dark">
                                    Chờ xác nhận
                                </span>
                            }
                            else if (Model.TrangThai == "DaXacNhan")
                            {
                                <span class="badge bg-info text-dark">
                                    Đã xác nhận
                                </span>
                            }
                            else if (Model.TrangThai == "DangGiao")
                            {
                                <span class="badge bg-primary">
                                    Đang giao
                                </span>
                            }
                            else if (Model.TrangThai == "HoanThanh")
                            {
                                <span class="badge bg-success">
                                    Hoàn thành
                                </span>
                            }
                            else if (Model.TrangThai == "DaHuy")
                            {
                                <span class="badge bg-danger">
                                    Đã hủy
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @Model.TrangThai
                                </span>
                            }
                        </div>
                    </div>

                    <form asp-action="CapNhatTrangThai"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.MaDonHang" />

                        <div class="mb-3">
                            <label class="form-label">
                                Cập nhật trạng thái
                            </label>

                            <select name="trangThai"
                                    class="form-select">

                                <option value="ChoXacNhan">
                                    Chờ xác nhận
                                </option>

                                <option value="DaXacNhan">
                                    Đã xác nhận
                                </option>

                                <option value="DangGiao">
                                    Đang giao
                                </option>

                                <option value="HoanThanh">
                                    Hoàn thành
                                </option>

                                <option value="DaHuy">
                                    Đã hủy
                                </option>

                            </select>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Cập nhật trạng thái
                        </button>

                    </form>

                </div>
            </div>

            <!-- TỔNG TIỀN -->
            <div class="card shadow-sm">
                <div class="card-body">

                    <h4 class="mb-4">
                        Thanh toán
                    </h4>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Tiền giảm</span>

                        <span>
                            @Model.TienGiam.ToString("N0") đ
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Phí vận chuyển</span>

                        <span>
                            @Model.PhiVanChuyen.ToString("N0") đ
                        </span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <strong>Tổng tiền</strong>

                        <strong class="text-danger fs-5">
                            @Model.TongTien.ToString("N0") đ
                        </strong>
                    </div>

                </div>
            </div>

        </div>

    </div>

</div>