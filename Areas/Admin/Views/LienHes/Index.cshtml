@model IEnumerable<CosmeticStore.Models.LienHe>

@{
    ViewData["Title"] = "Quản lý liên hệ";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                Quản lý liên hệ
            </h2>

            <p class="text-muted mb-0">
                Danh sách yêu cầu liên hệ từ khách hàng.
            </p>
        </div>

    </div>


    @if (TempData["ThongBaoThanhCong"] != null)
    {
        <div class="alert alert-success">
            @TempData["ThongBaoThanhCong"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            Chưa có liên hệ nào.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">

                    <tr>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Ngày gửi</th>
                        <th>Trạng thái</th>
                        <th style="width: 250px;">
                            Thao tác
                        </th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.HoTen
                            </td>

                            <td>
                                @item.Email
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.SoDienThoai)
                                    ? "-"
                                    : item.SoDienThoai)
                            </td>

                            <td>
                                @item.NgayGui.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>

                                @if (item.DaXuLy)
                                {
                                    <span class="badge bg-success">
                                        Đã xử lý
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Chưa xử lý
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="d-flex flex-wrap gap-2">

                                    <a asp-action="Details"
                                           asp-route-id="@item.LienHeId"
                                           class="btn btn-sm btn-outline-primary">

                                        Xem
                                    </a>


                                    @if (!item.DaXuLy)
                                    {
                                        <form asp-action="DanhDauDaXuLy"
                                              method="post">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.LienHeId" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-success">

                                                Đã xử lý
                                            </button>

                                        </form>
                                    }


                                    <form asp-action="Delete"
                                          method="post"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa liên hệ này?');">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.LienHeId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">

                                            Xóa
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>