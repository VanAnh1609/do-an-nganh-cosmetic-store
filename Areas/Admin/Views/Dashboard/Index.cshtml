@{
    ViewData["Title"] = "Trang quản trị";
}

<div class="container py-4">

    <h1>Trang quản trị</h1>

    <p class="text-muted">
        Chào mừng Admin đến với hệ thống quản lý CosmeticStore.
    </p>


    <div class="row g-3 mt-3">

        <!-- SẢN PHẨM -->
        <div class="col-md-4">
            <a asp-area="Admin"
                   asp-controller="SanPhams"
                   asp-action="Index"
                   class="btn btn-dark w-100 py-3">
                Quản lý sản phẩm
            </a>
        </div>


        <!-- DANH MỤC -->
        <div class="col-md-4">
            <a asp-area="Admin"
                   asp-controller="DanhMucs"
                   asp-action="Index"
                   class="btn btn-dark w-100 py-3">
                Quản lý danh mục
            </a>
        </div>


        <!-- THƯƠNG HIỆU -->
        <div class="col-md-4">
            <a asp-area="Admin"
                   asp-controller="ThuongHieus"
                   asp-action="Index"
                   class="btn btn-dark w-100 py-3">
                Quản lý thương hiệu
            </a>
        </div>


        <!-- KHÁCH HÀNG -->
        <div class="col-md-4">
            <a asp-area="Admin"
                   asp-controller="KhachHangs"
                   asp-action="Index"
                   class="btn btn-dark w-100 py-3">
                Quản lý khách hàng
            </a>
        </div>


        <!-- ĐƠN HÀNG -->
        <div class="col-md-4">
            <a asp-area="Admin"
                   asp-controller="DonHangs"
                   asp-action="Index"
                   class="btn btn-dark w-100 py-3">
                Quản lý đơn hàng
            </a>
        </div>


        <!-- MÃ GIẢM GIÁ -->
        <div class="col-md-4">
            <a asp-area="Admin"
                   asp-controller="MaGiamGias"
                   asp-action="Index"
                   class="btn btn-dark w-100 py-3">
                Quản lý mã giảm giá
            </a>
        </div>


        <!-- ĐÁNH GIÁ -->
        <div class="col-md-4">
            <a asp-area="Admin"
                   asp-controller="DanhGias"
                   asp-action="Index"
                   class="btn btn-dark w-100 py-3">
                Quản lý đánh giá
            </a>
        </div>


        <!-- NHÀ CUNG CẤP -->
        <div class="col-md-4">
            <a asp-area="Admin"
                   asp-controller="NhaCungCaps"
                   asp-action="Index"
                   class="btn btn-dark w-100 py-3">
                Quản lý nhà cung cấp
            </a>
        </div>


        <!-- NHẬP KHO -->
        <div class="col-md-4">
            <a asp-area="Admin"
                   asp-controller="PhieuNhaps"
                   asp-action="Index"
                   class="btn btn-dark w-100 py-3">
                Quản lý nhập kho
            </a>
        </div>


        <!-- LIÊN HỆ -->
        <div class="col-md-4">
            <a asp-area="Admin"
                   asp-controller="LienHes"
                   asp-action="Index"
                   class="btn btn-dark w-100 py-3">
                Quản lý liên hệ
            </a>
        </div>


        <!-- XEM TRANG CỬA HÀNG -->
        <div class="col-md-4">
            <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-dark w-100 py-3">
                Xem trang cửa hàng
            </a>
        </div>

    </div>

</div>