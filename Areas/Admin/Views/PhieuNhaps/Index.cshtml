@model IEnumerable<CosmeticStore.Models.PhieuNhap>

@{
    ViewData["Title"] = "Quản lý phiếu nhập";
}

<div class="container mt-3">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quản lý phiếu nhập</h2>

        <a asp-action="Create"
               class="btn btn-success">
            + Tạo phiếu nhập
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Chưa có phiếu nhập nào.
        </div>
    }
    else
    {
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Nhà cung cấp</th>
                    <th>Ngày nhập</th>
                    <th>Tổng tiền</th>
                    <th>Ghi chú</th>
                    <th style="width: 120px;">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            PN@(item.MaPhieuNhap.ToString("D4"))
                        </td>

                        <td>
                            @(item.NhaCungCap?.TenNhaCungCap
                                ?? "Không xác định")
                        </td>

                        <td>
                            @item.NgayNhap.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @item.TongTien.ToString("N0") đ
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(item.GhiChu)
                                ? "Không có"
                                : item.GhiChu)
                        </td>

                        <td>
                            <a asp-action="Details"
                                   asp-route-id="@item.MaPhieuNhap"
                                   class="btn btn-sm btn-info">
                                Chi tiết
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>