@model IEnumerable<CosmeticStore.Models.MaGiamGia>

@{
    ViewData["Title"] = "Quản lý mã giảm giá";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý mã giảm giá</h2>

    <a asp-action="Create" class="btn btn-primary">
        + Thêm mã giảm giá
    </a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Mã giảm giá</th>
            <th>Giảm</th>
            <th>Đơn tối thiểu</th>
            <th>Giảm tối đa</th>
            <th>Thời gian áp dụng</th>
            <th>Số lượng</th>
            <th>Trạng thái</th>
            <th style="width: 190px;">Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <strong>@item.TenMa</strong>
                </td>

                <td>
                    @item.PhanTramGiam%
                </td>

                <td>
                    @if (item.DonHangToiThieu.HasValue)
                    {
                        @item.DonHangToiThieu.Value.ToString("N0")
                        <span>đ</span>
                    }
                    else
                    {
                        <span>Không yêu cầu</span>
                    }
                </td>

                <td>
                    @if (item.GiamToiDa.HasValue)
                    {
                        @item.GiamToiDa.Value.ToString("N0")
                        <span>đ</span>
                    }
                    else
                    {
                        <span>Không giới hạn</span>
                    }
                </td>

                <td>
                    <div>
                        @item.NgayBatDau.ToString("dd/MM/yyyy")
                    </div>

                    <div class="text-muted">
                        đến @item.NgayKetThuc.ToString("dd/MM/yyyy")
                    </div>
                </td>

                <td>
                    @item.SoLuong
                </td>

                <td>
                    @if (item.TrangThai)
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Ngừng hoạt động</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit"
                           asp-route-id="@item.MaGiamGiaId"
                           class="btn btn-sm btn-warning">
                        Sửa
                    </a>

                    <a asp-action="Details"
                           asp-route-id="@item.MaGiamGiaId"
                           class="btn btn-sm btn-info">
                        Chi tiết
                    </a>

                    <a asp-action="Delete"
                           asp-route-id="@item.MaGiamGiaId"
                           class="btn btn-sm btn-danger">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>