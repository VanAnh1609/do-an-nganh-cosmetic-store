@model CosmeticStore.Models.MaGiamGia

@{
    ViewData["Title"] = "Xóa mã giảm giá";
}

<div class="container mt-3">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Xóa mã giảm giá</h4>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning">
                        Bạn có chắc chắn muốn xóa mã giảm giá này không?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Mã giảm giá</dt>
                        <dd class="col-sm-8">
                            <strong>@Model.TenMa</strong>
                        </dd>

                        <dt class="col-sm-4">Mô tả</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.MoTa) ? "Không có" : Model.MoTa)
                        </dd>

                        <dt class="col-sm-4">Phần trăm giảm</dt>
                        <dd class="col-sm-8">
                            @Model.PhanTramGiam%
                        </dd>

                        <dt class="col-sm-4">Đơn hàng tối thiểu</dt>
                        <dd class="col-sm-8">
                            @if (Model.DonHangToiThieu.HasValue)
                            {
                                @Model.DonHangToiThieu.Value.ToString("N0")
                                <span>đ</span>
                            }
                            else
                            {
                                <span>Không yêu cầu</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Giảm tối đa</dt>
                        <dd class="col-sm-8">
                            @if (Model.GiamToiDa.HasValue)
                            {
                                @Model.GiamToiDa.Value.ToString("N0")
                                <span>đ</span>
                            }
                            else
                            {
                                <span>Không giới hạn</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Ngày bắt đầu</dt>
                        <dd class="col-sm-8">
                            @Model.NgayBatDau.ToString("dd/MM/yyyy")
                        </dd>

                        <dt class="col-sm-4">Ngày kết thúc</dt>
                        <dd class="col-sm-8">
                            @Model.NgayKetThuc.ToString("dd/MM/yyyy")
                        </dd>

                        <dt class="col-sm-4">Số lượng</dt>
                        <dd class="col-sm-8">
                            @Model.SoLuong
                        </dd>

                        <dt class="col-sm-4">Trạng thái</dt>
                        <dd class="col-sm-8">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ngừng hoạt động</span>
                            }
                        </dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="MaGiamGiaId" />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                Xác nhận xóa
                            </button>

                            <a asp-action="Index" class="btn btn-secondary">
                                Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>