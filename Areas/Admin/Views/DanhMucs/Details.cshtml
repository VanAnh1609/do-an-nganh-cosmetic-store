@model CosmeticStore.Models.DanhMuc

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="mb-4">
                        Chi tiết danh mục
                    </h2>

                    <dl class="row mb-0">

                        <dt class="col-sm-4">
                            Mã danh mục
                        </dt>

                        <dd class="col-sm-8">
                            #@Model.MaDanhMuc
                        </dd>

                        <dt class="col-sm-4">
                            Tên danh mục
                        </dt>

                        <dd class="col-sm-8">
                            @Model.TenDanhMuc
                        </dd>

                        <dt class="col-sm-4">
                            Mô tả
                        </dt>

                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.MoTa)
                                ? "Chưa có mô tả"
                                : Model.MoTa)
                        </dd>

                        <dt class="col-sm-4">
                            Trạng thái
                        </dt>

                        <dd class="col-sm-8">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success">
                                    Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Đã ẩn
                                </span>
                            }
                        </dd>

                    </dl>

                    <div class="mt-4 d-flex gap-2">

                        <a asp-action="Edit"
                               asp-route-id="@Model.MaDanhMuc"
                               class="btn btn-warning">
                            Chỉnh sửa
                        </a>

                        <a asp-action="Index"
                               class="btn btn-secondary">
                            Quay lại
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>