@model CosmeticStore.Models.DanhMuc

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="mb-4">
                        Chỉnh sửa danh mục
                    </h2>

                    <form asp-action="Edit" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <input type="hidden"
                               asp-for="MaDanhMuc" />

                        <div class="mb-3">
                            <label asp-for="TenDanhMuc"
                                   class="form-label">
                            </label>

                            <input asp-for="TenDanhMuc"
                                   class="form-control"
                                   placeholder="Nhập tên danh mục" />

                            <span asp-validation-for="TenDanhMuc"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MoTa"
                                   class="form-label">
                            </label>

                            <textarea asp-for="MoTa"
                                      class="form-control"
                                      rows="4"
                                          placeholder="Nhập mô tả danh mục">
                            </textarea>

                                <span asp-validation-for="MoTa"
                                      class="text-danger">
                                </span>
                            </div>

                           

                            <div class="d-flex gap-2">

                                <button type="submit"
                                        class="btn btn-primary">
                                    Lưu thay đổi
                                </button>

                                <a asp-action="Index"
                                       class="btn btn-secondary">
                                    Quay lại
                                </a>

                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }