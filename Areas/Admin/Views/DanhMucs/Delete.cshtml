@model CosmeticStore.Models.DanhMuc

@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="text-danger mb-3">
                        Xóa danh mục
                    </h2>

                    <div class="alert alert-warning">
                        Bạn có chắc chắn muốn xóa danh mục này không?
                    </div>

                    <dl class="row">

                        <dt class="col-sm-4">
                            Tên danh mục
                        </dt>

                        <dd class="col-sm-8">
                            @Model.TenDanhMuc
                        </dd>

                        <dt class="col-sm-4">
                            Mô tả
                        </dt>

                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.MoTa)
                                ? "Chưa có mô tả"
                                : Model.MoTa)
                        </dd>

                        <dt class="col-sm-4">
                            Trạng thái
                        </dt>

                        <dd class="col-sm-8">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success">
                                    Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Đã ẩn
                                </span>
                            }
                        </dd>

                    </dl>

                    <form asp-action="Delete" method="post">

                        <input type="hidden"
                               asp-for="MaDanhMuc" />

                        <button type="submit"
                                class="btn btn-danger">
                            Xác nhận xóa
                        </button>

                        <a asp-action="Index"
                               class="btn btn-secondary">
                            Hủy
                        </a>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>