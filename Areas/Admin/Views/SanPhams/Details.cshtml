@model CosmeticStore.Models.SanPham

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<h2 class="mb-4">Chi tiết sản phẩm</h2>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="row">

            <div class="col-md-4 mb-4">

                @if (!string.IsNullOrWhiteSpace(Model.HinhAnh))
                {
                    <img src="@Model.HinhAnh"
                         alt="@Model.TenSanPham"
                         class="img-fluid rounded"
                         style="max-height: 300px; object-fit: cover;" />
                }
                else
                {
                    <div class="text-muted">
                        Chưa có hình ảnh
                    </div>
                }

            </div>

            <div class="col-md-8">

                <dl class="row">

                    <dt class="col-sm-4">
                        Mã sản phẩm
                    </dt>

                    <dd class="col-sm-8">
                        #@Model.MaSanPham
                    </dd>

                    <dt class="col-sm-4">
                        Tên sản phẩm
                    </dt>

                    <dd class="col-sm-8">
                        @Model.TenSanPham
                    </dd>

                    <dt class="col-sm-4">
                        Danh mục
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.DanhMuc?.TenDanhMuc
                            ?? "Chưa có danh mục")
                    </dd>

                    <dt class="col-sm-4">
                        Thương hiệu
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.ThuongHieu?.TenThuongHieu
                            ?? "Chưa có thương hiệu")
                    </dd>

                    <dt class="col-sm-4">
                        Giá bán
                    </dt>

                    <dd class="col-sm-8 fw-semibold text-danger">
                        @Model.GiaBan.ToString("N0") đ
                    </dd>

                    <dt class="col-sm-4">
                        Số lượng tồn
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.SoLuongTon <= 0)
                        {
                            <span class="badge bg-danger">
                                Hết hàng
                            </span>
                        }
                        else
                        {
                            @Model.SoLuongTon
                        }

                    </dd>

                    <dt class="col-sm-4">
                        Ngày tạo
                    </dt>

                    <dd class="col-sm-8">
                        @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")
                    </dd>

                    <dt class="col-sm-4">
                        Trạng thái
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.TrangThai)
                        {
                            <span class="badge bg-success">
                                Hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Đã ẩn
                            </span>
                        }

                    </dd>

                    <dt class="col-sm-4">
                        Mô tả
                    </dt>

                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.MoTa)
                            ? "Chưa có mô tả"
                            : Model.MoTa)
                    </dd>

                </dl>

            </div>

        </div>

    </div>
</div>

<div class="mt-3">

    <a asp-action="Edit"
           asp-route-id="@Model.MaSanPham"
           class="btn btn-warning">
        Chỉnh sửa
    </a>

    <a asp-action="Index"
           class="btn btn-secondary">
        Quay lại
    </a>

</div>