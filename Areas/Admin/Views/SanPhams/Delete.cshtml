@model CosmeticStore.Models.SanPham

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<h2 class="mb-4 text-danger">
    Xóa sản phẩm
</h2>

<div class="alert alert-warning">
    Bạn có chắc chắn muốn xóa sản phẩm này không?
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-sm-3">
                Mã sản phẩm
            </dt>

            <dd class="col-sm-9">
                #@Model.MaSanPham
            </dd>

            <dt class="col-sm-3">
                Tên sản phẩm
            </dt>

            <dd class="col-sm-9">
                @Model.TenSanPham
            </dd>

            <dt class="col-sm-3">
                Giá bán
            </dt>

            <dd class="col-sm-9">
                @Model.GiaBan.ToString("N0") đ
            </dd>

            <dt class="col-sm-3">
                Số lượng tồn
            </dt>

            <dd class="col-sm-9">
                @Model.SoLuongTon
            </dd>

            <dt class="col-sm-3">
                Trạng thái
            </dt>

            <dd class="col-sm-9">
                @if (Model.TrangThai)
                {
                    <span class="badge bg-success">
                        Hoạt động
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Đã ẩn
                    </span>
                }
            </dd>

        </dl>

    </div>
</div>

<form asp-action="Delete"
      method="post"
      class="mt-3">

    <input type="hidden"
           asp-for="MaSanPham" />

    <button type="submit"
            class="btn btn-danger">
        Xác nhận xóa
    </button>

    <a asp-action="Index"
           class="btn btn-secondary">
        Hủy
    </a>

</form>