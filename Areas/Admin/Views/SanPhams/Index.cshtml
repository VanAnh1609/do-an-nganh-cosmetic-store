@model IEnumerable<CosmeticStore.Models.SanPham>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Quản lý sản phẩm</h1>

            <p class="text-muted mb-0">
                Quản lý danh sách sản phẩm trong cửa hàng
            </p>
        </div>

        <a asp-action="Create"
               class="btn btn-primary">
            Thêm sản phẩm
        </a>
    </div>


    @if (TempData["ThongBaoThanhCong"] != null)
    {
        <div class="alert alert-success">
            @TempData["ThongBaoThanhCong"]
        </div>
    }

    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ThongBaoLoi"]
        </div>
    }


    <!-- TÌM KIẾM + LỌC -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <!-- Tìm theo tên -->
                <div class="col-md-3">

                    <label class="form-label">
                        Tìm kiếm
                    </label>

                    <input type="text"
                           name="tuKhoa"
                           value="@ViewBag.TuKhoa"
                           class="form-control"
                           placeholder="Nhập tên sản phẩm..." />

                </div>


                <!-- Danh mục -->
                <div class="col-md-2">

                    <label class="form-label">
                        Danh mục
                    </label>

                    <select name="maDanhMuc"
                            asp-items="ViewBag.DanhMucs"
                            class="form-select">

                        <option value="">
                            Tất cả danh mục
                        </option>

                    </select>

                </div>


                <!-- Thương hiệu -->
                <div class="col-md-2">

                    <label class="form-label">
                        Thương hiệu
                    </label>

                    <select name="maThuongHieu"
                            asp-items="ViewBag.ThuongHieus"
                            class="form-select">

                        <option value="">
                            Tất cả thương hiệu
                        </option>

                    </select>

                </div>


                <!-- Trạng thái bán -->
                <div class="col-md-2">

                    <label class="form-label">
                        Trạng thái bán
                    </label>

                    <select name="trangThai"
                            class="form-select">

                        <option value="">
                            Tất cả trạng thái
                        </option>

                        @if (ViewBag.TrangThai is bool trangThaiDangChon &&
                                                     trangThaiDangChon)
                        {
                            <option value="true" selected>
                                Đang bán
                            </option>
                        }
                        else
                        {
                            <option value="true">
                                Đang bán
                            </option>
                        }

                        @if (ViewBag.TrangThai is bool trangThaiDaAn &&
                                                     !trangThaiDaAn)
                        {
                            <option value="false" selected>
                                Đã ẩn
                            </option>
                        }
                        else
                        {
                            <option value="false">
                                Đã ẩn
                            </option>
                        }

                    </select>

                </div>


                <!-- Buttons -->
                <div class="col-md-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Tìm kiếm
                    </button>

                    <a asp-action="Index"
                           class="btn btn-secondary">
                        Đặt lại
                    </a>

                </div>

            </form>

        </div>
    </div>


    <!-- DANH SÁCH SẢN PHẨM -->
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Không tìm thấy sản phẩm phù hợp.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Mã SP
                            </th>

                            <th>
                                Sản phẩm
                            </th>

                            <th>
                                Danh mục
                            </th>

                            <th>
                                Thương hiệu
                            </th>

                            <th>
                                Giá bán
                            </th>

                            <th>
                                Tồn kho
                            </th>

                            <th>
                                Trạng thái bán
                            </th>

                            <th>
                                Ngày tạo
                            </th>

                            <th class="text-end">
                                Thao tác
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- Mã sản phẩm -->
                                <td>
                                    #@item.MaSanPham
                                </td>


                                <!-- Sản phẩm + ảnh -->
                                <td>

                                    <div class="d-flex align-items-center gap-2">

                                        @if (!string.IsNullOrWhiteSpace(item.HinhAnh))
                                        {
                                            <img src="@item.HinhAnh"
                                                 alt="@item.TenSanPham"
                                                 class="rounded"
                                                 style="
                                            width: 50px;
                                            height: 50px;
                                            object-fit: cover;
                                            " />
                                        }

                                        <span class="fw-semibold">
                                            @item.TenSanPham
                                        </span>

                                    </div>

                                </td>


                                <!-- Danh mục -->
                                <td>

                                    @(item.DanhMuc?.TenDanhMuc
                                        ?? "Chưa có danh mục")

                                </td>


                                <!-- Thương hiệu -->
                                <td>

                                    @(item.ThuongHieu?.TenThuongHieu
                                        ?? "Chưa có thương hiệu")

                                </td>


                                <!-- Giá bán -->
                                <td class="fw-semibold text-danger">

                                    @item.GiaBan.ToString("N0") đ

                                </td>


                                <!-- TỒN KHO -->
                                <td>

                                    @if (item.SoLuongTon <= 0)
                                    {
                                        <span class="badge bg-danger">
                                            Hết hàng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Còn hàng (@item.SoLuongTon)
                                        </span>
                                    }

                                </td>


                                <!-- TRẠNG THÁI BÁN -->
                                <td>

                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-primary">
                                            Đang bán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Đã ẩn
                                        </span>
                                    }

                                </td>


                                <!-- Ngày tạo -->
                                <td>

                                    @item.NgayTao.ToString("dd/MM/yyyy")

                                </td>


                                <!-- Thao tác -->
                                <td class="text-end">

                                    <a asp-action="Details"
                                           asp-route-id="@item.MaSanPham"
                                           class="btn btn-sm btn-info text-white">

                                        Chi tiết

                                    </a>


                                    <a asp-action="Edit"
                                           asp-route-id="@item.MaSanPham"
                                           class="btn btn-sm btn-warning">

                                        Chỉnh sửa

                                    </a>


                                    <!-- Ngừng bán / Mở bán -->
                                    <form asp-action="DoiTrangThai"
                                          asp-route-id="@item.MaSanPham"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        @if (item.TrangThai)
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-secondary">

                                                Ngừng bán

                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-success">

                                                Mở bán

                                            </button>
                                        }

                                    </form>


                                    <a asp-action="Delete"
                                           asp-route-id="@item.MaSanPham"
                                           class="btn btn-sm btn-danger">

                                        Xóa

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>